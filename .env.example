DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_data_platform

# --- Google Gemini (optional; AI features are disabled without a key) -------
# Create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2
GEMINI_TEMPERATURE=0
GEMINI_MAX_OUTPUT_TOKENS=2048

# --- AI safety / quota protection --------------------------------------------
AI_MAX_TOOL_CALLS=6
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_MESSAGE_CHARS=1000
AI_MAX_TOOL_ROWS=20
AI_REQUESTS_PER_MINUTE=20
AI_MAX_CONCURRENT=2

# --- Uploads / datasets ------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_DATASET_ROWS=500000
MAX_DATASET_COLUMNS=500
AIDP_DATA_DIR=data

# --- Machine learning ----------------------------------------------------------
ML_MIN_ROWS=20
ML_MAX_TRAIN_ROWS=100000
ML_RANDOM_STATE=42

# --- Server ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_JSON=true
